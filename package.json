{
  "name": "sidebar-todo",
  "displayName": "sidebar-todo",
  "description": "this is a to do list extension",
  "version": "0.0.1",
  "publisher": "KaiPatel",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaiPatel22/todo-list"
  },
  "license":"MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todoList",
          "title": "Todo List",
          "icon": "media/todo.svg"
        }
      ]
    },
    "views": {
      "todoList": [
        {
          "type": "webview",
          "id": "todoList.tasksView",
          "name": "Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "todo-list.helloWorld",
        "title": "todo-list"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
